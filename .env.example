# Copy to `.env` (local) or set as Cloudflare Pages environment variables.
# Never commit real values or any service-role key.

# Supabase project → Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Web Push public key (generate the pair with `npx web-push generate-vapid-keys`;
# the private key goes only in the send-push edge function secrets)
VITE_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
